# Copy this to .env and configure

# Option 1: Express/PostgreSQL backend
VITE_API_URL=http://localhost:5000/api

# Option 2: Google Sheets + Drive as backend (set this to enable)
# Deploy the Google Apps Script from google-apps-script/Code.gs and paste the web app URL here
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
